// The shared sounds (A4c, 05 §7): what champions without their own play, plus footsteps, death,
// respawn, recall and the hard-CC accent every champion shares. A recipe for `mftr-tools sfx
// build`, which writes export/biped_library.sfx.ron and export/sfx/*.ogg. Hand-written; the
// synth is documented in crates/mftr-tools/src/sfx.rs.
(
    pack: "biped_library",
    sounds: [
        // A generic cast: a short rising chirp with a shimmer.
        (name: "cast", events: ["*.cast"], volume: 0.4, pitch: 0.06, echo: (delay: 0.06, feedback: 0.25), layers: [
            (wave: "square", freq: (330.0, 660.0), env: (0.02, 0.05, 0.15), gain: 0.3, duty: 0.25, vibrato: (0.3, 18.0), lowpass: (5000.0, 3000.0)),
            (wave: "sine", freq: (660.0, 1320.0), env: (0.02, 0.03, 0.2), gain: 0.3, delay: 0.03),
        ]),
        // Something leaves the hand: an airy whoosh.
        (name: "release", events: ["*.release"], volume: 0.45, pitch: 0.08, layers: [
            (wave: "noise", freq: (22050.0, 22050.0), env: (0.01, 0.02, 0.15), gain: 0.8, lowpass: (1500.0, 5000.0), highpass: 300.0),
            (wave: "sine", freq: (500.0, 250.0), env: (0.0, 0.01, 0.08), gain: 0.2),
        ]),
        // Hits: a thump under a crunchy crack, two variants.
        (name: "hit_1", events: ["*.impact"], volume: 0.55, pitch: 0.08, crush: (bits: 10, hold: 1), layers: [
            (wave: "noise", freq: (9000.0, 2000.0), env: (0.0, 0.01, 0.08), gain: 0.7, lowpass: (6000.0, 1500.0)),
            (wave: "sine", freq: (180.0, 60.0), env: (0.0, 0.01, 0.12), gain: 0.9, punch: 0.5),
        ]),
        (name: "hit_2", events: ["*.impact"], volume: 0.55, pitch: 0.08, crush: (bits: 10, hold: 1), layers: [
            (wave: "noise", freq: (7000.0, 1600.0), env: (0.0, 0.015, 0.07), gain: 0.7, lowpass: (5000.0, 1200.0)),
            (wave: "sine", freq: (160.0, 55.0), env: (0.0, 0.01, 0.14), gain: 0.9, punch: 0.6),
        ]),
        // Delayed areas go off: rumble, boom and a metallic rattle.
        (name: "explode", events: ["*.detonate"], volume: 0.75, pitch: 0.05, crush: (bits: 8, hold: 2), echo: (delay: 0.09, feedback: 0.3), layers: [
            (wave: "noise", freq: (3000.0, 400.0), env: (0.0, 0.05, 0.6), gain: 1.0, lowpass: (5000.0, 400.0), drive: 0.5),
            (wave: "sine", freq: (90.0, 35.0), env: (0.0, 0.05, 0.5), gain: 1.0, punch: 1.0),
            (wave: "metal", freq: (6000.0, 2000.0), env: (0.0, 0.0, 0.2), gain: 0.3),
        ]),
        // Dashes: a whoosh out, a thump in.
        (name: "dash", events: ["*.start"], volume: 0.45, pitch: 0.06, layers: [
            (wave: "noise", freq: (22050.0, 22050.0), env: (0.04, 0.02, 0.18), gain: 0.9, lowpass: (800.0, 4000.0), highpass: 200.0),
        ]),
        (name: "land", events: ["*.land"], volume: 0.45, pitch: 0.08, layers: [
            (wave: "sine", freq: (140.0, 50.0), env: (0.0, 0.01, 0.1), gain: 0.9, punch: 0.5),
            (wave: "noise", freq: (4000.0, 800.0), env: (0.0, 0.0, 0.08), gain: 0.5, lowpass: (3000.0, 600.0)),
        ]),
        // Footsteps on the walk and run markers: three soft scuffs, quiet.
        (name: "step_1", events: ["unit.foot"], volume: 0.16, pitch: 0.1, layers: [
            (wave: "noise", freq: (2500.0, 700.0), env: (0.0, 0.005, 0.05), gain: 0.8, lowpass: (2500.0, 600.0)),
            (wave: "sine", freq: (110.0, 70.0), env: (0.0, 0.0, 0.05), gain: 0.5),
        ]),
        (name: "step_2", events: ["unit.foot"], volume: 0.16, pitch: 0.1, layers: [
            (wave: "noise", freq: (2200.0, 650.0), env: (0.0, 0.008, 0.05), gain: 0.8, lowpass: (2200.0, 550.0)),
            (wave: "sine", freq: (100.0, 65.0), env: (0.0, 0.0, 0.05), gain: 0.5),
        ]),
        (name: "step_3", events: ["unit.foot"], volume: 0.16, pitch: 0.1, layers: [
            (wave: "noise", freq: (2800.0, 750.0), env: (0.0, 0.004, 0.06), gain: 0.8, lowpass: (2700.0, 650.0)),
            (wave: "sine", freq: (120.0, 75.0), env: (0.0, 0.0, 0.04), gain: 0.5),
        ]),
        // Death: a falling, wobbling tone and a thud. Respawn: a rising shimmer.
        (name: "death", events: ["unit.death"], volume: 0.55, crush: (bits: 8, hold: 2), layers: [
            (wave: "square", freq: (440.0, 80.0), env: (0.0, 0.1, 0.7), gain: 0.5, vibrato: (0.5, 7.0), lowpass: (4000.0, 800.0)),
            (wave: "sine", freq: (120.0, 40.0), env: (0.0, 0.02, 0.25), gain: 0.9, punch: 0.6, delay: 0.55),
        ]),
        (name: "respawn", events: ["unit.respawn"], volume: 0.45, echo: (delay: 0.1, feedback: 0.4), layers: [
            (wave: "sine", freq: (330.0, 990.0), env: (0.1, 0.2, 0.5), gain: 0.5),
            (wave: "triangle", freq: (660.0, 1980.0), env: (0.05, 0.15, 0.4), gain: 0.3, delay: 0.1),
        ]),
        // Recall: a steady, rising hum (it has no in-game trigger yet).
        (name: "recall", events: ["unit.recall"], volume: 0.3, layers: [
            (wave: "sine", freq: (220.0, 330.0), env: (0.4, 1.6, 0.6), gain: 0.5, vibrato: (0.2, 5.0)),
            (wave: "triangle", freq: (440.0, 660.0), env: (0.6, 1.4, 0.6), gain: 0.25, vibrato: (0.15, 6.5)),
        ]),
        // The hard-CC accent (05 §7): a clang over a low gong, the same for every champion, so
        // "I'm about to be locked down" is one learnable sound. Plays on top of the hit.
        (name: "cc_hard", events: ["cc.hard"], volume: 0.7, crush: (bits: 8, hold: 1), echo: (delay: 0.12, feedback: 0.35), layers: [
            (wave: "metal", freq: (1200.0, 1200.0), env: (0.0, 0.02, 0.35), gain: 0.5, lowpass: (8000.0, 2000.0)),
            (wave: "square", freq: (196.0, 190.0), env: (0.0, 0.05, 0.4), gain: 0.5, duty: 0.125),
            (wave: "sine", freq: (98.0, 92.0), env: (0.0, 0.05, 0.5), gain: 0.8, punch: 0.5),
        ]),
        // The match's end, played flat when a Base falls: a brassy rising arpeggio into a held
        // major chord with a timpani roll for victory; a falling minor line for defeat.
        (name: "victory", events: ["match.victory"], volume: 0.7, echo: (delay: 0.11, feedback: 0.25), layers: [
            (wave: "square", freq: (392.0, 392.0), env: (0.01, 0.08, 0.06), gain: 0.28, duty: 0.25, lowpass: (3500.0, 2500.0), delay: 0.0),
            (wave: "square", freq: (523.3, 523.3), env: (0.01, 0.08, 0.06), gain: 0.28, duty: 0.25, lowpass: (3500.0, 2500.0), delay: 0.13),
            (wave: "square", freq: (659.3, 659.3), env: (0.01, 0.08, 0.06), gain: 0.28, duty: 0.25, lowpass: (3500.0, 2500.0), delay: 0.26),
            (wave: "square", freq: (523.3, 523.3), env: (0.02, 0.9, 0.9), gain: 0.24, duty: 0.3, vibrato: (0.08, 5.5), lowpass: (3200.0, 1800.0), delay: 0.39),
            (wave: "square", freq: (659.3, 659.3), env: (0.02, 0.9, 0.9), gain: 0.2, duty: 0.3, vibrato: (0.08, 5.5), lowpass: (3200.0, 1800.0), delay: 0.39),
            (wave: "square", freq: (784.0, 784.0), env: (0.02, 0.9, 0.9), gain: 0.2, duty: 0.3, vibrato: (0.08, 5.5), lowpass: (3200.0, 1800.0), delay: 0.39),
            (wave: "square", freq: (1046.5, 1046.5), env: (0.02, 0.9, 0.9), gain: 0.14, duty: 0.3, vibrato: (0.08, 5.5), lowpass: (3200.0, 1800.0), delay: 0.39),
            (wave: "triangle", freq: (130.8, 130.8), env: (0.02, 0.9, 0.9), gain: 0.35, delay: 0.39),
            (wave: "sine", freq: (110.0, 60.0), env: (0.0, 0.02, 0.4), gain: 0.7, punch: 0.6, delay: 0.39),
            (wave: "noise", freq: (2500.0, 600.0), env: (0.0, 0.02, 0.3), gain: 0.25, lowpass: (2500.0, 600.0), delay: 0.39),
        ]),
        (name: "defeat", events: ["match.defeat"], volume: 0.6, echo: (delay: 0.14, feedback: 0.3), layers: [
            (wave: "triangle", freq: (659.3, 659.3), env: (0.02, 0.12, 0.1), gain: 0.35, vibrato: (0.1, 5.0), delay: 0.0),
            (wave: "triangle", freq: (523.3, 523.3), env: (0.02, 0.12, 0.1), gain: 0.35, vibrato: (0.1, 5.0), delay: 0.22),
            (wave: "triangle", freq: (440.0, 440.0), env: (0.02, 0.12, 0.1), gain: 0.35, vibrato: (0.1, 5.0), delay: 0.44),
            (wave: "square", freq: (220.0, 220.0), env: (0.05, 0.8, 1.0), gain: 0.3, duty: 0.4, vibrato: (0.15, 4.0), lowpass: (1400.0, 600.0), delay: 0.66),
            (wave: "square", freq: (261.6, 261.6), env: (0.05, 0.8, 1.0), gain: 0.24, duty: 0.4, vibrato: (0.15, 4.0), lowpass: (1400.0, 600.0), delay: 0.66),
            (wave: "square", freq: (329.6, 329.6), env: (0.05, 0.8, 1.0), gain: 0.2, duty: 0.4, vibrato: (0.15, 4.0), lowpass: (1400.0, 600.0), delay: 0.66),
            (wave: "sine", freq: (110.0, 55.0), env: (0.0, 0.05, 0.8), gain: 0.6, delay: 0.66),
        ]),
    ],
)
