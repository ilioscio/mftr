// A wardrobe item (22 §4, BW5): a sewn long coat, open at the front, simulated (build.py, M1).
// Its own slot, `back`, so it is worn over a shirt or a tunic (one part a slot).
(
    id: "back.long_coat",
    slot: "back",
    name: "Long coat",
    layer: "armor",
    accent: true,
    rigid: false,
    // Spring-bone chains round the hips (22 §4.5, BW6): how many, their turn from the front
    // (degrees), and how much of the hem they carry (the rest follows the legs).
    chains: 4,
    chain_turn: 45,
    swing: 0.9,
)
