// Marrow's sounds (A13): bone and grave-light. A hollow hiss for her bolts and a dry crack where
// they land, Siphon's inward-sucking drone, Grasping Bones' rattling skitter and snap, Grave
// Pact's low rising chord, Ossuary's deep groan and clattering eruption, and a dry cackle for her
// emote. Footsteps, death and respawn come from the library. A recipe for `mftr-tools sfx build`.
(
    pack: "marrow",
    sounds: [
        (name: "hiss", events: ["attack.release"], volume: 0.4, pitch: 0.08, layers: [
            (wave: "noise", freq: (22050.0, 22050.0), env: (0.0, 0.03, 0.12), gain: 0.5, highpass: 2500.0, lowpass: (7000.0, 3000.0)),
            (wave: "sine", freq: (330.0, 220.0), env: (0.0, 0.02, 0.12), gain: 0.35, vibrato: (0.3, 20.0)),
        ]),
        (name: "crack", events: ["attack.impact"], volume: 0.45, pitch: 0.08, crush: (bits: 10, hold: 1), layers: [
            (wave: "noise", freq: (6000.0, 2000.0), env: (0.0, 0.0, 0.06), gain: 0.7, highpass: 1500.0),
            (wave: "sine", freq: (300.0, 120.0), env: (0.0, 0.01, 0.08), gain: 0.5),
        ]),
        (name: "siphon", events: ["q.detonate"], volume: 0.55, layers: [
            (wave: "noise", freq: (22050.0, 22050.0), env: (0.15, 0.05, 0.05), gain: 0.6, lowpass: (600.0, 4000.0)),
            (wave: "sine", freq: (110.0, 220.0), env: (0.1, 0.1, 0.1), gain: 0.5, vibrato: (0.4, 12.0)),
            (wave: "triangle", freq: (165.0, 330.0), env: (0.1, 0.1, 0.1), gain: 0.25),
        ]),
        (name: "rattle", events: ["w.release"], volume: 0.5, layers: [
            (wave: "noise", freq: (5000.0, 3000.0), env: (0.0, 0.25, 0.1), gain: 0.5, highpass: 1500.0, vibrato: (0.6, 28.0)),
            (wave: "sine", freq: (200.0, 80.0), env: (0.0, 0.02, 0.15), gain: 0.6, punch: 0.6),
        ]),
        (name: "snap", events: ["w.impact"], volume: 0.6, crush: (bits: 9, hold: 1), layers: [
            (wave: "noise", freq: (8000.0, 2500.0), env: (0.0, 0.0, 0.05), gain: 0.8, highpass: 1800.0),
            (wave: "noise", freq: (6000.0, 2000.0), env: (0.0, 0.0, 0.05), gain: 0.6, highpass: 1800.0, delay: 0.06),
            (wave: "sine", freq: (180.0, 70.0), env: (0.0, 0.01, 0.15), gain: 0.6, punch: 0.6),
        ]),
        (name: "pact", events: ["e.fire"], volume: 0.45, layers: [
            (wave: "sine", freq: (147.0, 220.0), env: (0.05, 0.2, 0.3), gain: 0.4),
            (wave: "sine", freq: (175.0, 262.0), env: (0.05, 0.2, 0.3), gain: 0.3),
            (wave: "noise", freq: (22050.0, 22050.0), env: (0.05, 0.15, 0.2), gain: 0.15, lowpass: (800.0, 2000.0)),
        ]),
        (name: "ossuary_call", events: ["r.fire"], volume: 0.5, layers: [
            (wave: "square", freq: (55.0, 45.0), env: (0.05, 0.3, 0.2), gain: 0.3, duty: 0.3, lowpass: (500.0, 300.0)),
            (wave: "sine", freq: (110.0, 70.0), env: (0.05, 0.3, 0.2), gain: 0.5, vibrato: (0.3, 6.0)),
        ]),
        (name: "ossuary", events: ["r.detonate"], volume: 0.8, crush: (bits: 9, hold: 2), echo: (delay: 0.09, feedback: 0.3), layers: [
            (wave: "sine", freq: (90.0, 30.0), env: (0.0, 0.03, 0.45), gain: 1.0, punch: 0.9),
            (wave: "noise", freq: (7000.0, 1500.0), env: (0.0, 0.2, 0.3), gain: 0.6, highpass: 1200.0, vibrato: (0.5, 22.0)),
            (wave: "noise", freq: (3000.0, 500.0), env: (0.0, 0.03, 0.3), gain: 0.5, lowpass: (3000.0, 500.0)),
        ]),
        (name: "cackle", events: ["unit.emote"], volume: 0.35, layers: [
            (wave: "square", freq: (420.0, 380.0), env: (0.0, 0.05, 0.04), gain: 0.25, duty: 0.3, lowpass: (2000.0, 2000.0)),
            (wave: "square", freq: (440.0, 400.0), env: (0.0, 0.05, 0.04), gain: 0.25, duty: 0.3, lowpass: (2000.0, 2000.0), delay: 0.12),
