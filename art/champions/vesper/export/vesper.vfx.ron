// Vesper's VFX (A4b): warm gold arrows, a teal-white Longshot, a lobbed shrapnel bomb, roll dust
// and a gold net. Instances of the client's VFX kit; widths and radii come from her kit's data
// (05 §1.1). Authored by hand next to the export; validated by `mftr-tools pack validate`.
(
    effects: [
        // Basic attack: a gold arrow, a small flare at the nock, a spark burst on the target.
        (event: "attack.release", kit: "flare", ramp: [(1.0, 0.97, 0.8), (1.0, 0.78, 0.38), (0.8, 0.42, 0.16)], count: 6, lifetime: 0.1),
        (event: "attack.projectile", kit: "arrow", ramp: [(1.0, 0.92, 0.6), (1.0, 0.7, 0.3), (0.7, 0.35, 0.12)]),
        (event: "attack.impact", kit: "burst", ramp: [(1.0, 1.0, 0.85), (1.0, 0.8, 0.4), (0.85, 0.45, 0.15), (0.4, 0.22, 0.12)], count: 12, speed: 3.0),

        // Q Longshot: teal-white, a bigger flare and a sharper hit.
        (event: "q.release", kit: "flare", ramp: [(0.92, 1.0, 1.0), (0.55, 0.95, 0.9), (0.18, 0.6, 0.6)], count: 10, size: 1.4, lifetime: 0.14),
        (event: "q.projectile", kit: "arrow", ramp: [(0.9, 1.0, 1.0), (0.5, 0.95, 0.88), (0.15, 0.55, 0.55)]),
        (event: "q.impact", kit: "burst", ramp: [(0.95, 1.0, 1.0), (0.55, 0.95, 0.9), (0.2, 0.6, 0.62), (0.1, 0.3, 0.32)], count: 18, speed: 4.0),

        // W Shrapnel Charge: a lobbed bomb that sizzles, then bursts in shrapnel and smoke.
        (event: "w.projectile", kit: "lob", ramp: [(0.3, 0.26, 0.22), (1.0, 0.65, 0.2), (0.9, 0.35, 0.1)]),
        (event: "w.detonate", kit: "burst", ramp: [(1.0, 0.95, 0.6), (1.0, 0.6, 0.15), (0.7, 0.25, 0.08), (0.25, 0.2, 0.18)], count: 32, speed: 5.0, lifetime: 0.5),
        (event: "w.detonate", kit: "ring", ramp: [(1.0, 0.85, 0.45), (0.85, 0.4, 0.12), (0.3, 0.25, 0.22)]),
        (event: "w.detonate", kit: "dust", ramp: [(0.45, 0.4, 0.36), (0.32, 0.3, 0.28), (0.22, 0.21, 0.2)], count: 14, speed: 1.8, size: 1.15),

        // E Tumble: dust when she rolls and when she lands.
        (event: "e.start", kit: "dust", ramp: [(0.64, 0.57, 0.46), (0.5, 0.46, 0.4), (0.38, 0.36, 0.33)], count: 10),
        (event: "e.land", kit: "dust", ramp: [(0.64, 0.57, 0.46), (0.5, 0.46, 0.4), (0.38, 0.36, 0.33)], count: 12, speed: 1.2),

        // R Snare Net: a spinning gold net, a ring where it catches.
        (event: "r.release", kit: "flare", ramp: [(1.0, 0.95, 0.7), (1.0, 0.8, 0.3), (0.8, 0.5, 0.15)], count: 12, size: 1.3),
        (event: "r.projectile", kit: "net", ramp: [(1.0, 0.88, 0.45), (0.85, 0.65, 0.25), (0.5, 0.35, 0.15)]),
        (event: "r.impact", kit: "ring", ramp: [(1.0, 0.9, 0.4), (0.9, 0.7, 0.25), (0.5, 0.4, 0.2)], count: 16),
        (event: "r.impact", kit: "burst", ramp: [(1.0, 0.95, 0.7), (1.0, 0.75, 0.3), (0.6, 0.4, 0.15)], count: 14),
    ],
