// Vesper's sounds (A4c): a creaking recurve, plucky twangs and wooden thunks; a bright Longshot;
// a hissing, rattling Shrapnel Charge; cloth on Tumble; a whirring net with a two-note "caught"
// motif (the shared hard-CC clang plays on top). Footsteps, death, respawn and recall come from
// the library. A recipe for `mftr-tools sfx build` (export/vesper.sfx.ron, export/sfx/*.ogg).
(
    pack: "vesper",
    sounds: [
        // Basic attack: draw creak, twang (two variants), thunk (two variants).
        (name: "draw", events: ["attack.cast"], volume: 0.3, pitch: 0.05, layers: [
            (wave: "saw", freq: (70.0, 95.0), env: (0.08, 0.05, 0.06), gain: 0.5, lowpass: (900.0, 1500.0)),
            (wave: "noise", freq: (3000.0, 6000.0), env: (0.1, 0.03, 0.05), gain: 0.3, lowpass: (2500.0, 4500.0), highpass: 800.0),
        ]),
        (name: "twang_1", events: ["attack.release"], volume: 0.5, pitch: 0.05, layers: [
            (wave: "triangle", freq: (392.0, 370.0), env: (0.0, 0.01, 0.22), gain: 0.7, punch: 0.8, vibrato: (0.2, 30.0)),
            (wave: "saw", freq: (784.0, 740.0), env: (0.0, 0.0, 0.12), gain: 0.3, lowpass: (5000.0, 1200.0)),
            (wave: "noise", freq: (22050.0, 22050.0), env: (0.0, 0.0, 0.02), gain: 0.5, highpass: 2000.0),
        ]),
        (name: "twang_2", events: ["attack.release"], volume: 0.5, pitch: 0.05, layers: [
            (wave: "triangle", freq: (415.0, 392.0), env: (0.0, 0.01, 0.2), gain: 0.7, punch: 0.8, vibrato: (0.2, 28.0)),
            (wave: "saw", freq: (831.0, 784.0), env: (0.0, 0.0, 0.11), gain: 0.3, lowpass: (5000.0, 1200.0)),
            (wave: "noise", freq: (22050.0, 22050.0), env: (0.0, 0.0, 0.02), gain: 0.5, highpass: 2000.0),
        ]),
        (name: "thunk_1", events: ["attack.impact"], volume: 0.45, pitch: 0.08, crush: (bits: 10, hold: 1), layers: [
            (wave: "sine", freq: (220.0, 90.0), env: (0.0, 0.005, 0.07), gain: 0.9, punch: 0.6),
            (wave: "noise", freq: (6000.0, 1500.0), env: (0.0, 0.0, 0.04), gain: 0.6, lowpass: (5000.0, 1500.0)),
        ]),
        (name: "thunk_2", events: ["attack.impact"], volume: 0.45, pitch: 0.08, crush: (bits: 10, hold: 1), layers: [
            (wave: "sine", freq: (200.0, 80.0), env: (0.0, 0.006, 0.08), gain: 0.9, punch: 0.6),
            (wave: "noise", freq: (5000.0, 1300.0), env: (0.0, 0.0, 0.05), gain: 0.6, lowpass: (4500.0, 1300.0)),
        ]),

        // Q Longshot: a longer draw with a rising shimmer, a heavy twang with a whoosh, a crack.
        (name: "longshot_draw", events: ["q.cast"], volume: 0.4, layers: [
            (wave: "saw", freq: (65.0, 100.0), env: (0.12, 0.08, 0.05), gain: 0.45, lowpass: (900.0, 1800.0)),
            (wave: "sine", freq: (880.0, 1760.0), env: (0.15, 0.05, 0.05), gain: 0.2, vibrato: (0.2, 12.0)),
        ]),
        (name: "longshot", events: ["q.release"], volume: 0.6, pitch: 0.03, echo: (delay: 0.07, feedback: 0.25), layers: [
            (wave: "triangle", freq: (330.0, 310.0), env: (0.0, 0.02, 0.3), gain: 0.7, punch: 1.0),
            (wave: "square", freq: (1320.0, 1250.0), env: (0.0, 0.0, 0.15), gain: 0.25, duty: 0.25, lowpass: (7000.0, 2000.0)),
            (wave: "noise", freq: (22050.0, 22050.0), env: (0.0, 0.02, 0.25), gain: 0.5, lowpass: (6000.0, 1500.0)),
        ]),
        (name: "longshot_hit", events: ["q.impact"], volume: 0.6, pitch: 0.05, crush: (bits: 9, hold: 1), layers: [
            (wave: "noise", freq: (22050.0, 22050.0), env: (0.0, 0.0, 0.03), gain: 0.9, highpass: 1500.0),
            (wave: "sine", freq: (300.0, 80.0), env: (0.0, 0.01, 0.12), gain: 0.9, punch: 0.8),
            (wave: "metal", freq: (5000.0, 3000.0), env: (0.0, 0.0, 0.08), gain: 0.3),
        ]),

        // W Shrapnel Charge: a fuse hiss, a low toss, a big rattling blast.
        (name: "fuse", events: ["w.cast"], volume: 0.3, layers: [
            (wave: "noise", freq: (22050.0, 22050.0), env: (0.02, 0.15, 0.08), gain: 0.5, lowpass: (9000.0, 6000.0), highpass: 3000.0),
            (wave: "metal", freq: (8000.0, 8000.0), env: (0.02, 0.15, 0.08), gain: 0.15),
        ]),
        (name: "toss", events: ["w.release"], volume: 0.4, pitch: 0.06, layers: [
            (wave: "noise", freq: (22050.0, 22050.0), env: (0.02, 0.03, 0.2), gain: 0.9, lowpass: (600.0, 2500.0)),
        ]),
        (name: "shrapnel", events: ["w.detonate"], volume: 0.8, pitch: 0.04, crush: (bits: 8, hold: 2), echo: (delay: 0.1, feedback: 0.3), layers: [
            (wave: "noise", freq: (2500.0, 300.0), env: (0.0, 0.06, 0.7), gain: 1.0, lowpass: (6000.0, 350.0), drive: 0.6),
            (wave: "sine", freq: (80.0, 30.0), env: (0.0, 0.05, 0.6), gain: 1.0, punch: 1.0),
            (wave: "metal", freq: (7000.0, 2500.0), env: (0.0, 0.02, 0.35), gain: 0.45, delay: 0.02),
            (wave: "noise", freq: (400.0, 150.0), env: (0.0, 0.1, 0.4), gain: 0.3, delay: 0.05, highpass: 1200.0),
        ]),

        // E Tumble: a cloth whoosh, then a thump and a scuff.
        (name: "tumble", events: ["e.start"], volume: 0.4, pitch: 0.06, layers: [
            (wave: "noise", freq: (22050.0, 22050.0), env: (0.03, 0.05, 0.18), gain: 0.9, lowpass: (700.0, 3000.0), highpass: 200.0),
        ]),
        (name: "tumble_land", events: ["e.land"], volume: 0.45, pitch: 0.06, layers: [
            (wave: "sine", freq: (130.0, 55.0), env: (0.0, 0.01, 0.09), gain: 0.8, punch: 0.5),
            (wave: "noise", freq: (3000.0, 900.0), env: (0.0, 0.03, 0.12), gain: 0.6, lowpass: (2500.0, 700.0)),
        ]),

        // R Snare Net: a whirl, a heavy twang with a rope whirr, and a jangle with a two-note
        // "caught" motif (the shared cc.hard clang plays with it).
        (name: "net_swing", events: ["r.cast"], volume: 0.4, layers: [
            (wave: "saw", freq: (110.0, 140.0), env: (0.05, 0.1, 0.1), gain: 0.4, vibrato: (3.0, 14.0), lowpass: (800.0, 1600.0)),
            (wave: "noise", freq: (22050.0, 22050.0), env: (0.05, 0.1, 0.1), gain: 0.4, lowpass: (1500.0, 3000.0)),
        ]),
        (name: "net_throw", events: ["r.release"], volume: 0.6, echo: (delay: 0.08, feedback: 0.2), layers: [
            (wave: "triangle", freq: (262.0, 247.0), env: (0.0, 0.02, 0.3), gain: 0.7, punch: 1.0),
            (wave: "saw", freq: (65.0, 55.0), env: (0.0, 0.05, 0.35), gain: 0.4, vibrato: (2.0, 22.0), lowpass: (1200.0, 600.0)),
            (wave: "noise", freq: (22050.0, 22050.0), env: (0.0, 0.05, 0.3), gain: 0.4, lowpass: (3000.0, 1000.0)),
        ]),
        (name: "net_snare", events: ["r.impact"], volume: 0.65, crush: (bits: 9, hold: 1), layers: [
            (wave: "metal", freq: (2600.0, 2400.0), env: (0.0, 0.02, 0.25), gain: 0.5, lowpass: (9000.0, 3000.0)),
            (wave: "square", freq: (523.0, 523.0), env: (0.0, 0.03, 0.08), gain: 0.3, duty: 0.125),
            (wave: "square", freq: (784.0, 784.0), env: (0.0, 0.04, 0.12), gain: 0.3, duty: 0.125, delay: 0.07),
            (wave: "sine", freq: (160.0, 60.0), env: (0.0, 0.01, 0.1), gain: 0.7, punch: 0.5),
        ]),

        // Emote: a three-note whistle (no in-game trigger yet).
        (name: "whistle", events: ["unit.emote"], volume: 0.4, layers: [
            (wave: "sine", freq: (880.0, 988.0), env: (0.02, 0.1, 0.06), gain: 0.5),
            (wave: "sine", freq: (1175.0, 1175.0), env: (0.02, 0.12, 0.1), gain: 0.5, delay: 0.2, vibrato: (0.3, 6.0)),
            (wave: "sine", freq: (988.0, 880.0), env: (0.02, 0.08, 0.15), gain: 0.5, delay: 0.45),
        ]),
    ],
)
