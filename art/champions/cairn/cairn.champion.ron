    format: 0,
    looks: (
        build: "humanoid_heavy",
        gender: Masculine,
        shape: (brow_ridge: 1, nose_length: 0.5, nose_width: 0.4, cheeks_hollow: 0.5, chin_length: 0.3, ears_point: 0.4, body_bulk: 0.6, body_belly: 0.3, neck_thickness: 0.6),
        proportions: (height: 0.2, arms: 0.2, hands: 0.3),
        skin: 4,
        outfit: ["head.horns", "torso.tunic", "shoulders.boulders", "back.cape", "arms.bracers", "legs.greaves", "waist.belt", "weapon.staff"],
