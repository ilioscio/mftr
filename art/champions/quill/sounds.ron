// Quill's sounds (A11): starlight and static. Bright arcane zaps for her bolts, Arc Shot's
// rising whistle and starburst, Static Field's crackle and hum, a quick hop for Recoil, and
// Starfall Lance's long gathering hum and searing release. Footsteps, death and respawn come from
// the library. A recipe for `mftr-tools sfx build`.
(
    pack: "quill",
    sounds: [
        (name: "zap", events: ["attack.release"], volume: 0.4, pitch: 0.08, layers: [
            (wave: "square", freq: (1600.0, 800.0), env: (0.0, 0.01, 0.1), gain: 0.3, duty: 0.25, lowpass: (6000.0, 2000.0)),
            (wave: "sine", freq: (2400.0, 1200.0), env: (0.0, 0.01, 0.08), gain: 0.25),
        ]),
        (name: "zap_hit", events: ["attack.impact"], volume: 0.4, pitch: 0.06, layers: [
            (wave: "noise", freq: (9000.0, 3000.0), env: (0.0, 0.0, 0.07), gain: 0.6, highpass: 2000.0),
            (wave: "sine", freq: (900.0, 400.0), env: (0.0, 0.01, 0.1), gain: 0.4),
        ]),
        (name: "arc_whistle", events: ["q.release"], volume: 0.45, layers: [
            (wave: "sine", freq: (800.0, 1600.0), env: (0.02, 0.15, 0.2), gain: 0.4, vibrato: (0.3, 9.0)),
            (wave: "noise", freq: (22050.0, 22050.0), env: (0.02, 0.1, 0.2), gain: 0.2, highpass: 3000.0),
        ]),
        (name: "starburst", events: ["q.detonate"], volume: 0.7, crush: (bits: 9, hold: 1), echo: (delay: 0.08, feedback: 0.3), layers: [
            (wave: "noise", freq: (9000.0, 1200.0), env: (0.0, 0.03, 0.4), gain: 0.7, lowpass: (9000.0, 1500.0)),
            (wave: "sine", freq: (1320.0, 660.0), env: (0.0, 0.02, 0.3), gain: 0.4),
            (wave: "sine", freq: (130.0, 50.0), env: (0.0, 0.02, 0.25), gain: 0.7, punch: 0.6),
        ]),
        (name: "static", events: ["w.detonate"], volume: 0.55, layers: [
            (wave: "noise", freq: (3000.0, 1500.0), env: (0.0, 0.3, 0.3), gain: 0.5, highpass: 2500.0),
            (wave: "square", freq: (110.0, 110.0), env: (0.02, 0.3, 0.3), gain: 0.2, duty: 0.3, vibrato: (0.2, 30.0), lowpass: (900.0, 900.0)),
            (wave: "noise", freq: (500.0, 300.0), env: (0.0, 0.3, 0.3), gain: 0.25, highpass: 3500.0),
        ]),
        (name: "recoil", events: ["e.start"], volume: 0.35, pitch: 0.06, layers: [
            (wave: "noise", freq: (22050.0, 22050.0), env: (0.02, 0.04, 0.14), gain: 0.8, lowpass: (900.0, 2800.0), highpass: 200.0),
        ]),
        (name: "lance_gather", events: ["r.cast"], volume: 0.5, layers: [
            (wave: "sine", freq: (220.0, 880.0), env: (0.45, 0.1, 0.05), gain: 0.4, vibrato: (0.3, 12.0)),
            (wave: "triangle", freq: (440.0, 1760.0), env: (0.45, 0.1, 0.05), gain: 0.2),
            (wave: "noise", freq: (22050.0, 22050.0), env: (0.4, 0.1, 0.05), gain: 0.15, highpass: 4000.0),
        ]),
        (name: "starfall", events: ["r.release"], volume: 0.75, echo: (delay: 0.1, feedback: 0.3), layers: [
            (wave: "noise", freq: (22050.0, 22050.0), env: (0.0, 0.05, 0.5), gain: 0.8, lowpass: (9000.0, 1500.0)),
            (wave: "square", freq: (440.0, 220.0), env: (0.0, 0.05, 0.4), gain: 0.25, duty: 0.25, lowpass: (5000.0, 1200.0)),
            (wave: "sine", freq: (110.0, 55.0), env: (0.0, 0.03, 0.35), gain: 0.6, punch: 0.8),
        ]),
        (name: "starfall_hit", events: ["r.impact"], volume: 0.7, crush: (bits: 9, hold: 1), layers: [
            (wave: "noise", freq: (22050.0, 22050.0), env: (0.0, 0.0, 0.06), gain: 0.8, highpass: 2000.0),
            (wave: "sine", freq: (220.0, 60.0), env: (0.0, 0.02, 0.3), gain: 0.9, punch: 0.8),
            (wave: "sine", freq: (1760.0, 880.0), env: (0.0, 0.02, 0.3), gain: 0.25),
        ]),
        (name: "star_count", events: ["unit.emote"], volume: 0.35, layers: [
            (wave: "sine", freq: (1320.0, 1320.0), env: (0.0, 0.02, 0.1), gain: 0.4),
            (wave: "sine", freq: (1480.0, 1480.0), env: (0.0, 0.02, 0.1), gain: 0.4, delay: 0.2),
            (wave: "sine", freq: (1660.0, 1660.0), env: (0.0, 0.02, 0.1), gain: 0.4, delay: 0.4),
            (wave: "sine", freq: (990.0, 990.0), env: (0.0, 0.03, 0.2), gain: 0.4, delay: 0.7),
        ]),
    ],
)
