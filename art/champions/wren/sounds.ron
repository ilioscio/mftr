// Wren's sounds (A14): string and steel. A crossbow's snapping twang and a thunk where the bolt
// lands, Ricochet's ringing ping, Caltrops' jingling toss and scatter, a quick rush for Pounce
// and a thump on landing, Hail of Arrows' high twang and whistling, drumming volley, and a short
// whistle for her emote. Footsteps, death and respawn come from the library. A recipe for
// `mftr-tools sfx build`.
(
    pack: "wren",
    sounds: [
        (name: "twang", events: ["attack.release"], volume: 0.4, pitch: 0.08, layers: [
            (wave: "triangle", freq: (220.0, 180.0), env: (0.0, 0.01, 0.12), gain: 0.5, vibrato: (0.5, 40.0)),
            (wave: "noise", freq: (22050.0, 22050.0), env: (0.0, 0.0, 0.05), gain: 0.5, highpass: 2000.0),
        ]),
        (name: "thunk", events: ["attack.impact"], volume: 0.45, pitch: 0.08, layers: [
            (wave: "sine", freq: (200.0, 90.0), env: (0.0, 0.01, 0.08), gain: 0.8, punch: 0.6),
            (wave: "noise", freq: (3000.0, 800.0), env: (0.0, 0.0, 0.05), gain: 0.5, lowpass: (3000.0, 800.0)),
        ]),
        (name: "ricochet_shot", events: ["q.release"], volume: 0.5, layers: [
            (wave: "triangle", freq: (260.0, 200.0), env: (0.0, 0.01, 0.15), gain: 0.5, vibrato: (0.5, 40.0)),
            (wave: "noise", freq: (22050.0, 22050.0), env: (0.0, 0.05, 0.1), gain: 0.4, highpass: 3000.0),
        ]),
        (name: "ping", events: ["q.impact"], volume: 0.5, pitch: 0.06, layers: [
            (wave: "metal", freq: (3200.0, 2600.0), env: (0.0, 0.01, 0.25), gain: 0.5),
            (wave: "sine", freq: (1800.0, 900.0), env: (0.0, 0.01, 0.15), gain: 0.3),
        ]),
        (name: "jingle", events: ["w.release"], volume: 0.4, layers: [
            (wave: "metal", freq: (4200.0, 3800.0), env: (0.0, 0.02, 0.1), gain: 0.35),
            (wave: "metal", freq: (3600.0, 3400.0), env: (0.0, 0.02, 0.1), gain: 0.3, delay: 0.06),
            (wave: "metal", freq: (4800.0, 4400.0), env: (0.0, 0.02, 0.1), gain: 0.25, delay: 0.12),
        ]),
        (name: "scatter", events: ["w.detonate"], volume: 0.5, crush: (bits: 10, hold: 1), layers: [
            (wave: "metal", freq: (4000.0, 3000.0), env: (0.0, 0.02, 0.2), gain: 0.4, vibrato: (0.4, 30.0)),
            (wave: "noise", freq: (8000.0, 3000.0), env: (0.0, 0.05, 0.2), gain: 0.4, highpass: 2500.0),
        ]),
        (name: "spring", events: ["e.start"], volume: 0.35, pitch: 0.06, layers: [
            (wave: "noise", freq: (22050.0, 22050.0), env: (0.02, 0.04, 0.12), gain: 0.8, lowpass: (900.0, 3000.0), highpass: 200.0),
        ]),
        (name: "pounce", events: ["e.land"], volume: 0.5, pitch: 0.06, layers: [
            (wave: "sine", freq: (150.0, 50.0), env: (0.0, 0.01, 0.16), gain: 0.9, punch: 0.7),
            (wave: "noise", freq: (2500.0, 600.0), env: (0.0, 0.01, 0.12), gain: 0.5, lowpass: (2500.0, 600.0)),
        ]),
        (name: "volley", events: ["r.fire"], volume: 0.55, layers: [
            (wave: "triangle", freq: (330.0, 260.0), env: (0.0, 0.01, 0.18), gain: 0.5, vibrato: (0.5, 40.0)),
            (wave: "sine", freq: (1400.0, 2400.0), env: (0.05, 0.3, 0.2), gain: 0.25),
            (wave: "noise", freq: (22050.0, 22050.0), env: (0.05, 0.3, 0.2), gain: 0.2, highpass: 3500.0),
        ]),
        (name: "hail", events: ["r.detonate"], volume: 0.75, crush: (bits: 9, hold: 1), echo: (delay: 0.07, feedback: 0.35), layers: [
            (wave: "sine", freq: (180.0, 70.0), env: (0.0, 0.01, 0.1), gain: 0.7, punch: 0.6),
            (wave: "sine", freq: (170.0, 65.0), env: (0.0, 0.01, 0.1), gain: 0.6, punch: 0.6, delay: 0.06),
            (wave: "sine", freq: (190.0, 72.0), env: (0.0, 0.01, 0.1), gain: 0.6, punch: 0.6, delay: 0.13),
            (wave: "noise", freq: (4000.0, 1000.0), env: (0.0, 0.1, 0.3), gain: 0.5, lowpass: (4000.0, 1000.0)),
        ]),
        (name: "whistle", events: ["unit.emote"], volume: 0.35, layers: [
            (wave: "sine", freq: (1200.0, 1800.0), env: (0.02, 0.1, 0.05), gain: 0.4),
            (wave: "sine", freq: (1800.0, 1100.0), env: (0.02, 0.15, 0.1), gain: 0.4, delay: 0.2),
        ]),
    ],
)
